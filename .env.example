# Neon PostgreSQL — copy from https://console.neon.tech (Connection string)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx.aws.neon.tech/neondb?sslmode=require

# Admin portal password (Node hosting / React /admin)
ADMIN_PASSWORD=change-me-in-production

# Optional extra signing secret
ADMIN_SECRET=optional-extra-signing-secret
