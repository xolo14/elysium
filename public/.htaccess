# Elysium Hotels — Hostinger shared hosting
# For subdomain root: elysiumhotel.grootdigitals.com  →  RewriteBase /
# For subfolder: domain.com/elysium/                    →  RewriteBase /elysium/
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Keep PHP API + desk admin reachable
  RewriteRule ^api/ - [L]
  RewriteRule ^desk/ - [L]

  # Legacy /admin → PHP desk (shared hosting)
  RewriteRule ^admin/?$ /admin.php [L]
  RewriteRule ^admin/.*$ /admin.php [L]

  # Existing files/folders as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Client-router fallback for unknown paths (prerendered routes are real HTML files).
  RewriteRule ^ index.html [L]
</IfModule>

# Always revalidate HTML so deploys show up after hard refresh
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>
