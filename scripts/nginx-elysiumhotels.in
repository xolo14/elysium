server {
    server_name elysiumhotels.in www.elysiumhotels.in;
    root /var/www/elysium/dist/client;
    index index.php index.html;

    client_max_body_size 8m;

    location = /api/config.php {
        deny all;
    }

    location ^~ /api/sql/ {
        deny all;
    }

    location ^~ /_bookings/ {
        deny all;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    location / {
        try_files $uri $uri/ $uri/index.html /index.html;
    }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/elysiumhotels.in/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/elysiumhotels.in/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    listen 80;
    listen [::]:80;
    server_name elysiumhotels.in www.elysiumhotels.in;

    if ($host = www.elysiumhotels.in) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = elysiumhotels.in) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    return 404; # managed by Certbot
}
